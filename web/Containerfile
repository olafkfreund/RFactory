# RFactory web app with the Phase 1b call bot (plan #8 step 8). Build from the repo root:
#   podman build -f web/Containerfile -t rfactory-web .
FROM docker.io/library/node:22-bookworm-slim

# Google Chrome (Meet refuses Chromium; Phase 0), Xvfb for the headed bot, espeak-ng (TTS fallback),
# python3-venv for Piper. Chrome is pinned: CHROME_VERSION is the version the first 1b build installed.
ARG CHROME_VERSION=157.0.8103.78-1
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends xvfb xauth fonts-liberation fonts-noto-color-emoji \
      ca-certificates curl gnupg espeak-ng python3-venv; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /etc/apt/keyrings/google.gpg; \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google.gpg] https://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends "google-chrome-stable${CHROME_VERSION:+=$CHROME_VERSION}"; \
    rm -rf /var/lib/apt/lists/*

# Piper (GPL-3.0, its own process) and the public-domain LJSpeech voice, pinned by commit and sha256.
RUN set -eux; \
    python3 -m venv /opt/piper; \
    /opt/piper/bin/pip install --no-cache-dir piper-tts==1.8.0; \
    mkdir -p /opt/voices; cd /opt/voices; \
    base=https://huggingface.co/rhasspy/piper-voices/resolve/4a409e3cbfd0a189930b38f127a38e107677e8ac/en/en_US/ljspeech/medium; \
    curl -fsSLo en_US-ljspeech-medium.onnx "$base/en_US-ljspeech-medium.onnx"; \
    curl -fsSLo en_US-ljspeech-medium.onnx.json "$base/en_US-ljspeech-medium.onnx.json"; \
    printf '%s  %s\n' \
      6f52a751e2349abe7a76735eb09dc1875298c77ea2342ffd2fef79ff81b87f22 en_US-ljspeech-medium.onnx \
      141d612cc0a95ed7efc1ca936b845c2364967f2e9217c5dbfcf69fc4d6c65860 en_US-ljspeech-medium.onnx.json \
      | sha256sum -c -

# The brain runs `claude -p`; pinned to the version 1a checked (destination hash includes it).
RUN npm install -g @anthropic-ai/claude-code@2.1.326 && npm cache clean --force

WORKDIR /app
COPY --chown=node:node core/package.json core/package-lock.json core/
RUN cd core && npm ci --omit=dev
COPY --chown=node:node web/package.json web/package-lock.json web/
RUN cd web && npm ci --omit=dev
COPY --chown=node:node bot/package.json bot/package-lock.json bot/
RUN cd bot && npm ci --omit=dev
COPY --chown=node:node core/src core/src
COPY --chown=node:node core/bin core/bin
# #2's GitHub adapter loads its recorded read-only tool inventory from this fixture (#2 plan step 4)
COPY --chown=node:node core/test/fixtures/github-tools-1.14.0.json core/test/fixtures/
COPY --chown=node:node bot/run.js bot/
COPY --chown=node:node web/server.js web/call.js web/tts.js web/actions.js web/actions-record.js web/live-view.js web/desktop-routes.js web/
COPY --chown=node:node desktop/runner/vnc.js desktop/runner/vsock.js desktop/runner/client.js desktop/runner/
COPY --chown=node:node web/public web/public

USER node
ENV PORT=8080 \
    PATH=/opt/piper/bin:$PATH \
    RFACTORY_VOICE=/opt/voices/en_US-ljspeech-medium.onnx \
    CHROME_PATH=/usr/bin/google-chrome-stable
CMD ["node", "web/server.js"]
